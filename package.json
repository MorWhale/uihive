{
  "name": "@morwhale/uihive",
  "version": "0.0.1",
  "description": "Open-source UI component registry compatible with shadcn/ui — public and private, P2P via mDNS.",
  "license": "MIT",
  "keywords": [
    "ui",
    "components",
    "registry",
    "shadcn",
    "tailwind",
    "radix",
    "p2p",
    "mDNS"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MorWhale/uihive.git"
  },
  "homepage": "https://github.com/MorWhale/uihive#readme",
  "bugs": "https://github.com/MorWhale/uihive/issues",
  "type": "module",
  "bin": {
    "uihive": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "@clack/prompts": "^0.8.0",
    "@swc/core": "^1.7.0",
    "bonjour-service": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "@vitest/coverage-v8": "^2.1.0"
  }
}
